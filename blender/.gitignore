# Blender working files — reproducibility contract is that any .blend can be
# regenerated by running `blender -b -P scripts/<zone>/build.py`.
# If a .blend can't be scripted, promote it explicitly by removing it here.

*.blend1
*.blend2
*.blend.bak
scenes/*.blend

# Locally-captured reference screenshots (third-party copyright).
refs/

# Working renders (only commit final preview screenshots in renders/).
renders/working/

# Asset cache (PolyHaven downloads etc.)
.cache/

# Bake intermediates — PNGs from Cycles bake. The compressed .ktx2 outputs
# land in public/textures/hall/baked/ and ship; these PNGs are only for
# diff/inspection between bake runs.
exports/baked/

# Python bytecode from headless script runs
__pycache__/
*.pyc
