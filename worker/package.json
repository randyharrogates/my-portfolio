  },
  "dependencies": {
    "openai": "^7.55.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.160.0"
  }
}
