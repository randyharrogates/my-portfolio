{
  "name": "portfolio-fit-worker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "corpus": "node --no-warnings corpus/build.ts",
    "test": "node --no-warnings --test test/*.test.ts",
    "typecheck": "tsc -p .",
    "check": "npm run typecheck && npm test",
    "dev": "wrangler dev --env dev",
